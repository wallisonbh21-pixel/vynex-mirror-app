# ScaleNexus — exemplo de variáveis de ambiente (SEM valores reais)
# Configure na Vercel: Project Settings → Environment Variables.

# --- Públicas (vão para o navegador; são seguras) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Secretas (somente servidor; NUNCA use prefixo VITE_) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Acesso administrativo ao banco: cadastro de clientes, funil, aprovações, convites,
# exclusão de clientes, painel admin e prospecção. Indisponível enquanto o banco
# estiver na Lovable Cloud — essas funções falham na Vercel sem ela.
SUPABASE_SERVICE_ROLE_KEY=
# Gateway Lovable: NexusBuild AI, geração de imagens, e-mails (Resend) e pesquisa web (Firecrawl)
LOVABLE_API_KEY=
RESEND_API_KEY=
FIRECRAWL_API_KEY=
# Prospecção (Geoapify)
GEOAPIFY_API_KEY=
# Opcional: modelo de IA do NexusBuild (padrão google/gemini-2.5-pro)
NEXUS_AI_MODEL=
# Endereço final do site (links em e-mails). Ex.: https://www.seudominio.com.br
SITE_URL=

# Imagens do Studio: nenhuma variável nova. Usam SUPABASE_URL/SUPABASE_PUBLISHABLE_KEY
# (ou as VITE_* embutidas) para entregar /api/public/site-image/...
